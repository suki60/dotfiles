# theme
theme = Atom One Dark

# font
font-family = Cascadia Code
font-size = 15

# window
window-padding-x = 10
window-padding-y = 10
window-decoration = true
macos-titlebar-style = tabs

# cursor
cursor-style = block
cursor-style-blink = false

# behavior
shell-integration = zsh
# Over ssh, copy Ghostty's terminfo to the remote host, or fall back to xterm-256color, so keys like Delete work.
shell-integration-features = ssh-terminfo,ssh-env
copy-on-select = false
confirm-close-surface = false

# keybinds
# Send Alt+Enter so zsh runs run-and-copy-output (replaces the default fullscreen toggle).
keybind = cmd+enter=text:\x1b\r
# Send Alt+A so zsh runs copy-last-output.
keybind = shift+cmd+enter=text:\x1ba
# Zoom the current split to fill the tab (Ghostty's default on shift+cmd+enter).
keybind = ctrl+alt+cmd+space=toggle_split_zoom
# Send Ctrl+_ so zsh undoes the last line edit.
keybind = cmd+z=text:\x1f
# Send Alt+V so Claude Code starts voice push-to-talk.
keybind = ctrl+shift+alt+cmd+space=text:\x1bv
# Send Shift+Home / Shift+End so zsh-shift-select selects to the line start / end.
keybind = cmd+shift+left=text:\x1b[1;2H
keybind = cmd+shift+right=text:\x1b[1;2F
# Type /exit + Enter so Claude Code quits in one press (its own exit keys need a double press).
keybind = cmd+escape=text:/exit\r
# Type exit + Enter to quit shells and ssh sessions.
keybind = ctrl+escape=text:exit\r
# Shrink the split to ~1/3: reset to 50/50 first so repeated presses land on the same size
keybind = ctrl+shift+alt+cmd+]=equalize_splits
keybind = chain=resize_split:right,267
# Back to 50/50
keybind = ctrl+shift+alt+cmd+[=equalize_splits
# New split on the right, already at ~1/3 of the window
keybind = ctrl+shift+alt+cmd+d=new_split:right
keybind = chain=equalize_splits
keybind = chain=resize_split:right,406
# Move the current tab one place left / right (wraps at the ends).
keybind = ctrl+[=move_tab:-1
keybind = ctrl+]=move_tab:1
# Go to the tab on the right / left.
keybind = alt+]=next_tab
keybind = alt+[=previous_tab
# New split on the right / left, like cmd+d.
keybind = shift+cmd+]=new_split:right
keybind = shift+cmd+[=new_split:left

# macOS
macos-option-as-alt = true
