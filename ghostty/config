# theme
theme = Atom One Dark

# font
font-family = Cascadia Code
font-size = 15

# window
window-padding-x = 10
window-padding-y = 10
window-decoration = true
macos-titlebar-style = tabs
background-opacity = 0.9
background-blur = true

# cursor
cursor-style = block
cursor-style-blink = false

# behavior
shell-integration = zsh
copy-on-select = true
confirm-close-surface = false

# keybinds
# Send Alt+Enter so zsh runs run-and-copy-output (replaces the default fullscreen toggle).
keybind = cmd+enter=text:\x1b\r
# Send Ctrl+_ so zsh undoes the last line edit.
keybind = cmd+z=text:\x1f

# macOS
macos-option-as-alt = true