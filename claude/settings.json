{
  "autoUpdates": false,
  "awaySummaryEnabled": false,
  "model": "sonnet",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:push*)",
      "Bash(npx drizzle-kit migrate*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(drizzle-kit migrate*)",
      "Bash(drizzle-kit push*)",
      "Bash(node -e*)",
      "Bash(psql*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "theme": "dark-ansi",
  "worktree": {
    "bgIsolation": "none"
  }
}