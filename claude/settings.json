{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git add*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git tag*)",
      "Bash(git worktree*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:push*)",
      "Bash(npx drizzle-kit migrate*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(drizzle-kit migrate*)",
      "Bash(drizzle-kit push*)",
      "Bash(node -e*)",
      "Bash(psql*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "worktree": {
    "bgIsolation": "none"
  },
  "spinnerTipsEnabled": false,
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "autoUpdates": false,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
