{
  "model": "sonnet",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "worktree": {
    "bgIsolation": "none"
  }
}