{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(npm publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:push*)",
      "Bash(npx drizzle-kit migrate*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(drizzle-kit migrate*)",
      "Bash(drizzle-kit push*)",
      "Bash(node -e*)",
      "Bash(psql*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "worktree": {
    "bgIsolation": "none"
  },
  "spinnerTipsEnabled": false,
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "autoUpdates": false
}
