{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "space": null,
        "meta+v": "voice:pushToTalk"
      }
    },
    {
      "context": "Scroll",
      "bindings": {
        "home": "scroll:top",
        "end": "scroll:bottom"
      }
    }
  ]
}
