{
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[go]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.insertSpaces": false
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "biome.enabled": false,
  "bookmarks.sideBar.countBadge": "off",
  "chat.fontSize": 14,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.enableNewConversationShortcut": true,
  "claudeCode.focusView": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.codeActionsOnSave": {},
  "editor.defaultFormatter": "vscode.typescript-language-features",
  "editor.dragAndDrop": false,
  "editor.fontFamily": "'Cascadia Code', monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss19', 'ss20'",
  "editor.fontSize": 15,
  "editor.fontWeight": "300",
  "editor.formatOnPaste": false,
  "editor.glyphMargin": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.minimap.enabled": false,
  "editor.suggest.filterGraceful": false,
  "editor.tabSize": 2,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "keyword",
          "keyword.control",
          "storage.type",
          "storage.modifier",
          "comment"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
  "explorer.autoReveal": "focusNoScroll",
  "extensions.ignoreRecommendations": true,
  "files.exclude": {
    "": true,
    "**/.git": true
  },
  "git-graph.dialog.rebase.launchInteractiveRebase": true,
  "git-graph.repository.showRemoteBranches": false,
  "git.allowForcePush": true,
  "git.allowNoVerifyCommit": true,
  "git.autoRepositoryDetection": false,
  "git.confirmNoVerifyCommit": false,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "git.showReferenceDetails": false,
  "git.suggestSmartCommit": false,
  "gitblame.statusBarMessageFormat": "${author.name} (${time.ago})",
  "gitHistory.showFileHistorySplit": false,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "gopls": {
    "ui.navigation.importShortcut": "Definition"
  },
  "js/ts.format.semicolons": "remove",
  "js/ts.preferGoToSourceDefinition": true,
  "liveServer.settings.donotShowInfoMsg": true,
  "multiCommand.commands": [
    {
      "command": "multiCommand.scmFocus",
      "interval": 10,
      "sequence": [
        "workbench.scm.focus",
        "list.focusFirst"
      ]
    },
    {
      "command": "multiCommand.scmFocusMessage",
      "sequence": [
        "multiCommand.scmFocus",
        "list.select"
      ]
    },
    {
      "command": "multiCommand.scmFocusChanges",
      "sequence": [
        "multiCommand.scmFocus",
        "list.focusDown",
        "list.focusDown",
        "list.focusDown"
      ]
    }
  ],
  "prettier.semi": false,
  "problems.decorations.enabled": false,
  "search.quickOpen.includeHistory": false,
  "search.smartCase": true,
  "search.useParentIgnoreFiles": true,
  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.untrustedFiles": "open",
  "tailwindCSS.experimental.classRegex": [
    [
      "cva\\(([^)]*)\\)",
      "[\"'`]([^\"'`]*).*?[\"'`]"
    ],
    [
      "cn\\(([^)]*)\\)",
      "(?:'|\"|`)([^']*)(?:'|\"|`)"
    ]
  ],
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "args": [
        "-l",
        "-i"
      ],
      "path": "/bin/zsh"
    }
  },
  "terminal.integrated.shellIntegration.enabled": false,
  "typescriptExplorer.typeTree.view.icons.colors.enable": false,
  "typescriptExplorer.typeTree.view.icons.enable": false,
  "update.showReleaseNotes": false,
  "window.commandCenter": false,
  "window.confirmSaveUntitledWorkspace": false,
  "workbench.activityBar.location": "top",
  "workbench.browser.showInTitleBar": false,
  "workbench.colorTheme": "One Dark Pro",
  "workbench.editor.defaultBinaryEditor": "default",
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.focusRecentEditorAfterClose": false,
  "workbench.editor.preventPinnedEditorClose": "never",
  "workbench.editor.showTabIndex": true,
  "workbench.editor.useModal": "off",
  "workbench.editorAssociations": {
    "*.svg": "default"
  },
  "workbench.iconTheme": "file-icons",
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "zenMode.fullScreen": false
}