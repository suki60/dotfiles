{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "git-clean-all",
      "type": "shell",
      "command": "git reset --hard && git clean -fd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "copy-repo-name",
      "type": "shell",
      "command": "basename \"$PWD\" | pbcopy",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "claude-commit",
      "type": "shell",
      "command": "claude -p --no-session-persistence --model haiku '/gc'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "claude-stage-related",
      "type": "shell",
      "command": "claude -p --no-session-persistence --model haiku \"/gs $GS_DESCRIPTION\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GS_DESCRIPTION": "${input:gsDescription}"
        }
      },
      "presentation": {
        "reveal": "never",
        "close": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "gsDescription",
      "type": "promptString",
      "description": "Describe the changes to stage"
    }
  ]
}
